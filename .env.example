NODE_ENV=development
PORT=3000

# Postgres connection string
DATABASE_URL=postgres://flowboard:flowboard@localhost:5432/flowboard

# JWT — must be at least 32 characters
JWT_SECRET=change-me-to-a-real-secret-at-least-32-chars
JWT_EXPIRES_IN=7d

# Email provider: ses | resend | console (console is the safe local default)
EMAIL_PROVIDER=console
AWS_REGION=
SES_FROM_ADDRESS=
RESEND_API_KEY=
RESEND_FROM_ADDRESS=

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000
